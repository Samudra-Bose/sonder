# Sonder Server Environment Configuration Example
# Copy to .env and adjust variables for your local setup.
# Never commit real credentials or .env to version control.

PORT=3001
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sonder_dev
COOKIE_SECRET=change-this-in-production-to-a-secure-random-string
CORS_ORIGIN=http://localhost:5173
