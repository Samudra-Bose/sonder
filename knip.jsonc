{
  "$schema": "https://unpkg.com/knip@5/overview/configuration-schema.json",
  "workspaces": {
    ".": {
      "ignore": ["lighthouserc.cjs"]
    },
    "apps/web": {
      "entry": [
        "src/main.tsx!",
        "src/components/ui/index.ts!",
        "src/modules/**/index.ts!",
        "playwright.config.ts",
        ".storybook/main.ts",
        ".storybook/preview.tsx"
      ],
      "project": ["src/**/*.{ts,tsx}!", "e2e/**/*.ts"],
      "ignoreDependencies": [
        "@storybook/addon-a11y",
        "@storybook/addon-vitest",
        "@tailwindcss/vite"
      ]
    },
    "packages/contracts": {
      "entry": ["src/index.ts!", "scripts/generate-ws-types.mjs"],
      "project": ["src/**/*.ts!"],
      "ignore": [
        "src/api-types.ts",
        "src/ws-events-types.ts",
        "src/ws-protocol-types.ts"
      ]
    }
  }
}
