{
  "$schema": "https://unpkg.com/knip@5/overview/configuration-schema.json",
  "ignoreBinaries": ["renovate-config-validator"],
  "workspaces": {
    ".": {
      "ignore": ["lighthouserc.cjs"],
    },
    "apps/web": {
      "entry": ["src/components/ui/index.ts!", "src/modules/**/index.ts!"],
      "project": ["src/**/*.{ts,tsx}!", "e2e/**/*.ts"],
      "ignoreDependencies": ["tailwindcss"],
    },
    "packages/contracts": {
      "project": ["src/**/*.ts!"],
    },
  },
}
