{
  "safety-guard": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "bash ./hooks/scripts/pre-command-check.sh",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "session-reminder": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "bash ./hooks/scripts/session-reminder.sh",
        "timeout": 5
      }
    ]
  }
}
